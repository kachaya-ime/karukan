<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Karukan" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color (Blue) -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_primary_variant</item>
        <item name="colorOnPrimary">@color/blue_on_primary</item>

        <!-- Secondary accent color (Light Blue / Cyan) -->
        <item name="colorSecondary">@color/cyan_secondary</item>
        <item name="colorSecondaryVariant">@color/cyan_secondary_variant</item>
        <item name="colorOnSecondary">@color/cyan_on_secondary</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
</resources>
